# Dockerfile для миграций
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Установка goose для миграций
RUN go install github.com/pressly/goose/v3/cmd/goose@latest

# Копируем модули
COPY go.mod go.sum ./
RUN go mod download

# Копируем исходный код мигратора
COPY cmd/migrator ./cmd/migrator
RUN CGO_ENABLED=0 go build -o /bin/migrator ./cmd/migrator

# Финальный образ
FROM alpine:latest

RUN apk --no-cache add ca-certificates postgresql-client

WORKDIR /app

COPY --from=builder /bin/migrator /bin/migrator
COPY --from=builder /go/bin/goose /bin/goose

# Копируем миграции
COPY migrations ./migrations

ENTRYPOINT ["/bin/migrator"]